  <!-- EN: aim assistance -->
  <AimAssistance.label>hỗ trợ mục tiêu</AimAssistance.label>
  <!-- EN: This weapon contains a rudimentary aim assistant computer which helps track targets, increasing accuracy at all ranges. The device can account for environmental challenges, allowing the weapon to ignore the accuracy penalty from bad weather and smoke. -->
  <AimAssistance.description>Loại vũ khí này chứa một máy tính hỗ trợ ngắm bắn thô sơ giúp theo dõi mục tiêu, tăng độ chính xác ở mọi phạm vi. Thiết bị này có thể giải quyết các thách thức về môi trường, cho phép vũ khí bỏ qua mức độ chính xác do thời tiết xấu và khói.</AimAssistance.description>
  <!-- EN: seeking -->
  <AimAssistance.traitAdjectives.0>đang tìm kiếm</AimAssistance.traitAdjectives.0>
  <!-- EN: accurate -->
  <AimAssistance.traitAdjectives.1>chính xác</AimAssistance.traitAdjectives.1>
  <!-- EN: precise -->
  <AimAssistance.traitAdjectives.2>chính xác</AimAssistance.traitAdjectives.2>
  <!-- EN: auto-aim -->
  <AimAssistance.traitAdjectives.3>tự động nhắm</AimAssistance.traitAdjectives.3>
  <!-- EN: self-aim -->
  <AimAssistance.traitAdjectives.4>tự nhắm</AimAssistance.traitAdjectives.4>
  
  <!-- EN: bioferrite burner -->
